# XAU/USD PREDATOR v10.1 CONFIGURATION
# Salin file ini menjadi '.env' lalu sesuaikan parameternya

# Instrumen Pasar
SYMBOL=XAUUSD=X

# Manajemen Modal & Resiko
ACCOUNT_BALANCE=10000.0
RISK_PERCENT=1.0
MAX_ALLOWED_RISK_PERCENT=1.5
CONTRACT_SIZE=100.0
MIN_RR_RATIO=2.0
COOLDOWN_HOURS=4
MIN_PRICE_MOVE_DOLLARS=8.0

# Telegram Bot Alert
TELEGRAM_TOKEN=123456789:ABCDEF_YourTelegramBotTokenHere
TELEGRAM_CHAT_ID=-1001234567890

# Sesi Jam Trading (WIB)
SESSION_START_HOUR=13
SESSION_END_HOUR=23

# Mode Loop Terus-menerus (VPS / Docker)
RUN_CONTINUOUS_LOOP=false
POLL_INTERVAL_SECONDS=300

# MetaTrader 5 Auto-Trading Bridge (Opsional)
MT5_AUTO_EXECUTION=false
MT5_LOGIN=12345678
MT5_PASSWORD=YourTradingPassword
MT5_SERVER=ICMarketsSC-Demo
MT5_MAGIC_NUMBER=888101
